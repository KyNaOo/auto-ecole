# Valeurs par défaut pour l'environnement Docker de développement.
# Surchargez-les localement dans .env.local (non versionné).

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_dev_secret_0123456789ab
# URL utilisée pour générer les liens hors requête HTTP (e-mails, CLI)
DEFAULT_URI=http://localhost:8000
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://app:app@database:3306/bddautoecoleweb?serverVersion=8.4.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Mailpit (http://localhost:8025) capture tous les e-mails envoyés
MAILER_DSN=smtp://mailer:1025
###< symfony/mailer ###
