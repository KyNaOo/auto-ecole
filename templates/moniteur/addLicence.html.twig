
{% block title %}New Licence{% endblock %}

{% block body %}
    <h1>Create new Licence</h1>
    {{ form_start(form) }}
        {{ form_row(form.codecategorie) }}
        {{ form_row(form.dateobtention) }}
         {{ form_widget(form.codeuser, {
             'attr': {
                 'style': 'visibility: hidden;'
             }
         }) }}
        <button class="btn">{{ button_label|default('Save') }}</button>

    {{ form_end(form) }}
    <a href="{{ path('app_licence_index') }}">back to list</a>
{% endblock %}
