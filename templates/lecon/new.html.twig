{% extends 'admin/index.html.twig' %}

{% block title %}New Lecon{% endblock %}

{% block body %}
    {% block admin %}
        {{ parent() }}
    {% endblock %}
    <h1>Create new Lecon</h1>
    {% if app.flashes('error') %}
        <div class="alert alert-danger">
            {% for message in app.flashes('error') %}
                {{ message }}
            {% endfor %}
        </div>
    {% endif %}

    {{ include('lecon/_form.html.twig') }}

    <a href="{{ path('app_lecon_index') }}">back to list</a>
{% endblock %}
