<body class="u-body u-xl-mode"    data-lang="fr"><header class="u-clearfix u-header u-header" id="sec-fabd"><div class="u-clearfix u-sheet u-sheet-1">

    </div></header>
<section class="u-align-left u-clearfix u-section-1" id="carousel_8074">
    <div class="u-clearfix u-sheet u-sheet-1">
        <h2 class="u-custom-font u-font-montserrat u-text u-text-black u-text-1"> Statistiques numériques de l'auto école</h2>
        <div class="u-clearfix u-layout-wrap u-layout-wrap-1">
            <div class="u-layout">
                <div class="u-layout-row">
                    <div class="u-size-60">
                        <div class="u-layout-col">
                            <div class="u-size-20">
                                <div class="u-layout-row">
                                    <div class="u-align-center u-container-style u-layout-cell u-size-13 u-layout-cell-1">
                                        <div class="u-container-layout u-valign-top u-container-layout-1">
                                            <div class="u-align-center u-container-style u-group u-palette-3-base u-preserve-proportions u-shape-circle u-group-1">
                                                <div class="u-container-layout u-valign-middle">
                                                    <h3 class="u-custom-font u-font-montserrat u-text u-text-2" data-animation-name="counter" data-animation-event="scroll" data-animation-duration="3000">{{ nbUseMono }}</h3>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="u-container-style u-layout-cell u-shape-rectangle u-size-47 u-layout-cell-2">
                                        <div class="u-container-layout u-valign-middle u-container-layout-3">
                                            <p class="u-custom-font u-heading-font u-text u-text-grey-40 u-text-3">{% if verifCountMono == true%}Les moniteurs les  plus solicités sont :
                                                {% for moniteur in moniteurs %}
                                                '{{ moniteur['nom'] }}',
                                            {% endfor %}
                                            ils ont été appelé {% for moniteur in moniteurs %}
                                                {{ moniteur['nbLecon'] }},
                                            {% endfor %}
                                            fois.
                                                {% else %}
                                                Le moniteur le  plus solicité est :
                                                {% for moniteur in moniteurs %}
                                                    '{{ moniteur['nom'] }}',
                                                {% endfor %}
                                                il a été appelé {{ nbUseMono }} fois.
                                                {% endif %}
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="u-size-20">
                                <div class="u-layout-row">
                                    <div class="u-align-center u-container-style u-layout-cell u-size-13 u-layout-cell-3">
                                        <div class="u-container-layout u-valign-top u-container-layout-4">
                                            <div class="u-align-center u-container-style u-group u-palette-3-base u-preserve-proportions u-shape-circle u-group-2">
                                                <div class="u-container-layout u-valign-middle">
                                                    <h3 class="u-custom-font u-font-montserrat u-text u-text-4" data-animation-name="counter" data-animation-event="scroll" data-animation-duration="3000">{{ nbUseVeh }}</h3>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="u-container-style u-layout-cell u-size-47 u-layout-cell-4">
                                        <div class="u-container-layout u-valign-middle u-container-layout-6">
                                            <p class="u-custom-font u-heading-font u-text u-text-grey-40 u-text-5">{% if verifCountVeh == true%}Les véhicules les plus utilisés sont :
                                                    {% for vehicule in vehicules %}
                                                        '{{ vehicule['marque'] }} - {{ vehicule['modele'] }}',
                                                    {% endfor %}
                                                    Ils ont été utilisés {{ nbUseVeh }} fois.
                                                {% else %}
                                                    Le vehicule le  plus utilisé est :
                                                    {% for vehicule in vehicules %}
                                                        {{ vehicule['marque'] }} - {{ vehicule['modele'] }},
                                                    {% endfor %}
                                                    il a été appelé {{ nbUseVeh }} fois.
                                                {% endif %}

                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
