{% extends 'base.html.twig' %}

{% block title %}Moniteur{% endblock %}

{% block body %}
    <h1>Moniteur</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ moniteur.id }}</td>
            </tr>
            <tr>
                <th>Nommoniteur</th>
                <td>{{ moniteur.nommoniteur }}</td>
            </tr>
            <tr>
                <th>Prenommoniteur</th>
                <td>{{ moniteur.prenommoniteur }}</td>
            </tr>
            <tr>
                <th>Sexemoniteur</th>
                <td>{{ moniteur.sexemoniteur }}</td>
            </tr>
            <tr>
                <th>Maissancemoniteur</th>
                <td>{{ moniteur.maissancemoniteur ? moniteur.maissancemoniteur|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Adressemoniteur</th>
                <td>{{ moniteur.adressemoniteur }}</td>
            </tr>
            <tr>
                <th>Codepostalemoniteur</th>
                <td>{{ moniteur.codepostalemoniteur }}</td>
            </tr>
            <tr>
                <th>Villemoniteur</th>
                <td>{{ moniteur.villemoniteur }}</td>
            </tr>
            <tr>
                <th>Telephonemoniteur</th>
                <td>{{ moniteur.telephonemoniteur }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_moniteur_index') }}">back to list</a>

    <a href="{{ path('app_moniteur_edit', {'id': moniteur.id}) }}">edit</a>

    {{ include('moniteur/_delete_form.html.twig') }}
{% endblock %}
