{% extends 'base.html.twig' %}

{% block title %}Eleve index{% endblock %}

{% block body %}
    <h1>Eleve index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom de l'eleve</th>
                <th>Prenom de l'eleve</th>
                <th>Sexe de eleve</th>
                <th>Date de naissance</th>
                <th>Adresse</th>
                <th>Code postale</th>
                <th>Ville</th>
                <th>Telephone</th>
                <th>login</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for eleve in eleves %}
            <tr>
                <td>{{ eleve.id }}</td>
                <td>{{ eleve.nomeleve }}</td>
                <td>{{ eleve.prenomeleve }}</td>
                <td>{{ eleve.sexeeleve }}</td>
                <td>{{ eleve.datenaissance ? eleve.datenaissance|date('Y-m-d') : '' }}</td>
                <td>{{ eleve.adresse }}</td>
                <td>{{ eleve.codepostale }}</td>
                <td>{{ eleve.ville }}</td>
                <td>{{ eleve.telephone }}</td>
                <td>{{ eleve.login }}</td>
                <td>
                    <a href="{{ path('app_eleve_show', {'id': eleve.id}) }}">show</a>
                    <a href="{{ path('app_eleve_edit', {'id': eleve.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="11">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_eleve_new') }}">Create new</a>
{% endblock %}
