<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/axentix@2.2.1/dist/axentix.min.css">
<script src="https://cdn.jsdelivr.net/npm/axentix@2.2.1/dist/axentix.min.js"></script>
<div class="grix xs2">

    <div>Email</div>
    <div>{{ app.user.email }}</div>
    <div>Mot de passe</div>
    <form method="post">
        <div class="form-field">
            <label for="pass">Mot de passe</label>
            <input type="password" id="pass" name="pass" class="form-control">
        </div>
        <div class="form-field">
            <label for="pass2">Confirmer le mot de passe</label>
            <input type="password" id="pass2" name="pass2" class="form-control">
        </div>
        <button class="btn shadow-1 rounded-1 blue">Modifier le mot de passe</button>
    </form>
</div>