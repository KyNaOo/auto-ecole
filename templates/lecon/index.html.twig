{% extends 'admin/index.html.twig' %}

{% block title %}Lecon index{% endblock %}

{% block body %}
    {% block admin %}
        {{ parent() }}
    {% endblock %}
    <h1>Liste de leçon</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Heure</th>
                <th>Reglée</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for lecon in lecons %}
            <tr>
                <td>{{ lecon.date ? lecon.date|date('Y-m-d') : '' }}</td>
                <td>{{ lecon.heure }}</td>
                <td>{{ lecon.reglee }}</td>
                <td>
                    <a href="{{ path('app_lecon_show', {'id': lecon.id}) }}">show</a>
                    <a href="{{ path('app_lecon_edit', {'id': lecon.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_lecon_new') }}">Create new</a>
{% endblock %}
