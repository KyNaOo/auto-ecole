{% extends 'admin/index.html.twig' %}

{% block title %}Licence{% endblock %}

{% block body %}
    {% block admin %}
        {{ parent() }}
    {% endblock %}
    <h1>Licence</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ licence.id }}</td>
            </tr>
            <tr>
                <th>Codemoniteur</th>
                <td>{{ licence.codeuser ? licence.codeuser.prenom ~ ' ' ~ licence.codeuser.nom }}</td>
            </tr>
            <tr>
                <th>Codecategorie</th>
                <td>{{ licence.codecategorie }}</td>
            </tr>
            <tr>
                <th>Dateobtention</th>
                <td>{{ licence.dateobtention ? licence.dateobtention|date('Y-m-d') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_licence_index') }}">back to list</a>

    <a href="{{ path('app_licence_edit', {'id': licence.id}) }}">edit</a>

    {{ include('licence/_delete_form.html.twig') }}
{% endblock %}
