<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/axentix@2.2.1/dist/axentix.min.css">
<script src="https://cdn.jsdelivr.net/npm/axentix@2.2.1/dist/axentix.min.js"></script>
<nav class="navbar shadow-1 grey dark-4">
    <a class="navbar-brand">Moniteur</a>
    <!-- Dark menu background hover variant -->
    <div class="navbar-menu ml-auto hover-bg-dark">
        <a class="navbar-link active" href="#">Planning</a>
        <a class="navbar-link" href="#">Profil</a>
        <a class="navbar-link" href="#">Stats</a>
        <a class="navbar-link" href="#">Licence</a>
    </div>
</nav>
{% block body %}
    <h1>BIENVENUE !</h1>
    {% for message in app.flashes('message') %}
        <div class="col-xs4">
            <div class="p-3 my-2 rounded-1 green light-4 text-green text-dark-4">{{ message }}</div>
        </div>
    {% endfor %}
    <div class="grix xs2">
        <div>Email</div>
        <div>{{ app.user.email }}</div>
        <div>Nom</div>
        <div>{{ app.user.nom }}</div>
        <div>Prénom</div>
        <div>{{ app.user.prenom }}</div>
        <a href="{{ path('app_logout') }}" class="btn shadow-1 rounded-1 blue">Déconnexion</a>
        <a href="{{ path('app_moniteur_edit') }}" class="btn shadow-1 rounded-1 blue">Modifier le profil</a>
        <a href="{{ path('app_moniteur_editPass') }}" class="btn shadow-1 rounded-1 blue">Modifier le mot de passe</a>
    </div>
{% endblock %}
