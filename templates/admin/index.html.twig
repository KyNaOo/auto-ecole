<!DOCTYPE html>
<html>
{% block body %}
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Welcome Admin!{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
    {# Run `composer require symfony/webpack-encore-bundle` to start using Symfony UX #}
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    {% endblock %}

    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
    {% endblock %}
    {% block admin %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/axentix@2.2.1/dist/axentix.min.css">
    <script src="https://cdn.jsdelivr.net/npm/axentix@2.2.1/dist/axentix.min.js"></script>
    <nav class="navbar shadow-1 grey dark-4">
        <a class="navbar-brand">{% block role %}Admin{% endblock %}</a>
        <!-- Dark menu background hover variant -->
        <div class="navbar-menu ml-auto hover-bg-dark">
            <a class="navbar-link" href="{{ path('app_registerMoniteur') }}">Moniteur</a>
            <a class="navbar-link" href="{{ path('app_lecon_index') }}">Leçon</a>
            <a class="navbar-link" href="{{ path('app_user') }}">Profil</a>
            <a class="navbar-link" href="{{ path('app_vehicule_index') }}">Véhicule</a>
            <a class="navbar-link" href="{{ path('app_licence_index') }}">Licence</a>
            <a class="navbar-link" href="{{ path('app_categorie_index') }}">Categorie</a>
            <a class="navbar-link" href="#">Stats</a>
        </div>
    </nav>
    {% endblock %}
</head>
{% block navbar %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/axentix@2.2.1/dist/axentix.min.css">
    <script src="https://cdn.jsdelivr.net/npm/axentix@2.2.1/dist/axentix.min.js"></script>
{% endblock %}
    <h1>BIENVENUE !</h1>
    {% for message in app.flashes('message') %}
    <div class="col-xs4">
        <div class="p-3 my-2 rounded-1 green light-4 text-green text-dark-4">{{ message }}</div>
    </div>
    {% endfor %}
    <div class="grix xs2">
        <div>Email</div>
        <div>{{ app.user.email }}</div>
        <div>Nom</div>
        <div>{{ app.user.nom }}</div>
        <div>Prénom</div>
        <div>{{ app.user.prenom }}</div>
        <a href="{{ path('app_logout') }}" class="btn shadow-1 rounded-1 blue">Déconnexion</a>
        <a href="{{ path('app_admin_edit') }}" class="btn shadow-1 rounded-1 blue">Modifier le profil</a>
        <a href="{{ path('app_user_editPass') }}" class="btn shadow-1 rounded-1 blue">Modifier le mot de passe</a>
    </div>
{% endblock %}
