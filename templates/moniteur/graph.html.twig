{% extends 'admin/index.html.twig' %}

{% block title %}Vehicule{% endblock %}

{% block body %}
    {% block admin %}
        {{ parent() }}
    {% endblock %}



    <canvas id="monGraph" width="400" height="100"></canvas>
    <canvas id="monGraph2" width="400" height="100"></canvas>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.3/Chart.min.js" integrity="sha512-s+xg36jbIujB2S2VKfpGmlC3T5V2TF3lY48DX7u2r9XzGzgPsa6wTpOQA7J9iffvdeBN0q9tKzRxVxw1JviZPg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
        let somme = [];
        let labelle=[];
        {% for i in result %}
            somme.push({{ i.somme }});
            labelle.push("{{ i.libelle }}");
        {% endfor %}

        let nb = [];
        let labelle2=[];
        {% for i in result2 %}
            nb.push({{ i.nb }});
            labelle2.push("{{ i.libelle2 }}");
        {% endfor %}

        let ctx=document.querySelector("#monGraph")
        let ctx2=document.querySelector("#monGraph2")


        let graph = new Chart
        (ctx,
            {
                type:"pie",
                data:
                    {
                        labels:labelle,
                        datasets:
                            [
                                {
                                    label:'nombre de votes',
                                    data: somme,
                                    backgroundColor:['red','blue','purple']
                                }
                            ]
                    },
                options:
                    {
                        title:
                            {
                                display:true,
                                text:'prix par categorie'
                            },
                        legend:
                            {
                                position:'bottom'
                            }

                    }
            }
        )

        let graph2 = new Chart
        (ctx2,
            {
                type:"pie",
                data:
                    {
                        labels:labelle2,
                        datasets:
                            [
                                {
                                    label:'nombre de votes',
                                    data: nb,
                                    //data: [1,2],
                                    // borderColor:'red',
                                    //les points
                                    backgroundColor:['red','blue']
                                }
                            ]
                    },
                options:
                    {
                        title:
                            {
                                display:true,
                                text:'nombre de lecon par categorie'
                            },
                        legend:
                            {
                                position:'bottom'
                            }

                    }
            }
        )
    </script>


{% endblock %}
